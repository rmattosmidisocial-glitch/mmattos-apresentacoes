{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "functions": {
    "api/analisar.js": {
      "maxDuration": 60
    },
    "api/lead.js": {
      "maxDuration": 30
    },
    "api/leads.js": {
      "maxDuration": 30
    }
  }
}